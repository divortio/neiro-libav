diff -rupN '--exclude=node_modules' '--exclude=dist' '--exclude=bun.lock' '--exclude=package-lock.json' neiro/tests/codecs/libav.test.ts neiro-libav/tests/codecs/libav.test.ts
--- neiro/tests/codecs/libav.test.ts	1969-12-31 19:00:00.000000000 -0500
+++ neiro-libav/tests/codecs/libav.test.ts	2026-03-18 07:18:39.310209592 -0400
@@ -0,0 +1,44 @@
+import { describe, expect, it } from "vitest";
+import { AudioTrack } from "../../src/audio-track";
+import { calculateIntegratedLoudness } from "../../src/dsp/lufs";
+import fs from "fs";
+import path from "path";
+import { fileURLToPath } from "url";
+
+const __filename = fileURLToPath(import.meta.url);
+const __dirname = path.dirname(__filename);
+
+describe("Libav.js Format Decoding & DSP Integration", () => {
+    const fixturesDir = path.resolve(__dirname, "../../../../../../tests/fixtures");
+    const formats = ["wav", "mp3", "m4a", "flac"];
+
+    for (const ext of formats) {
+        it(`Successfully normalizes 60s generated ${ext} test tone`, async () => {
+            const fileBuf = fs.readFileSync(path.join(fixturesDir, `test.${ext}`));
+            const track = await AudioTrack.fromBuffer(fileBuf);
+
+            // Verify basic decode bounds for the 60s test tone
+            expect(track.duration).toBeGreaterThan(58);
+            expect(track.duration).toBeLessThan(62);
+            expect(track.sampleRate).toBe(44100);
+
+            // Validate LUFS tracking & DSP application
+            const preLufs = track.loudness();
+            const normalized = track.normalize({ target: -14, peakLimit: -1.0 });
+            const postLufs = normalized.loudness();
+
+            expect(Math.abs(postLufs - -14)).toBeLessThan(1.5); // within 1.5 lufs
+            console.log(`[${ext.toUpperCase()}] Normalized natively from ${preLufs.toFixed(2)} LUFS to ${postLufs.toFixed(2)} LUFS.`);
+        }, 15000); // 15s timeout
+    }
+    
+    it("Ignores raw headerless PCM bytes gracefully when probing throws", async () => {
+        const pcmBuf = fs.readFileSync(path.join(fixturesDir, `test.pcm`));
+        try {
+            await AudioTrack.fromBuffer(pcmBuf);
+        } catch (e) {
+            expect(e.message.match(/Unknown audio format|Invalid data/)).toBeTruthy();
+        }
+    });
+
+});
